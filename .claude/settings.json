{
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run dvc status:*)",
      "Bash(uv run dvc dag:*)",
      "Bash(uv run dvc repro:*)",
      "Bash(uv run python:*)",
      "Bash(uv sync:*)",
      "Bash(uv lock:*)",
      "Bash(uv tree:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(gh pr *)",
      "PowerShell(gh pr list --repo Oppen-OC/TFM --state all)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\\\n\" https://api.github.com/repos/Oppen-OC/TFM/pulls)",
      "Bash(curl -s https://api.github.com/repos/Oppen-OC/TFM/pulls?state=all)"
    ],
    "deny": [
      "Read(./.env)",
      "Write(./.env)",
      "Edit(./.env)",
      "Edit(./dvc.lock)",
      "Write(./dvc.lock)",
      "Edit(./uv.lock)",
      "Write(./uv.lock)",
      "Bash(pip install:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -Command \"$p = ($input | Out-String | ConvertFrom-Json).tool_input.file_path; if ($p -like '*.py') { uv run ruff format $p; uv run ruff check --fix $p }\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
