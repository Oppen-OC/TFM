# Fuente de verdad de qué variables existen. Si añades una a config.py,
# añádela aquí. `.env` está gitignorado y nunca se commitea.

# App
APP_NAME=tfm
ENV=development
LOG_LEVEL=info

# API
API_HOST=0.0.0.0
API_PORT=8000

# Model
MODEL_PATH=models/model.pkl

# Keys
API_KEY=

# Datos
# Raíz del corpus. Todas las demás rutas (raw/, curated/, reference/,
# interim/, processed/) se derivan de esta. En la Raspberry del colector
# esto vale /srv/tfm-data.
DATA_ROOT=data

# Zona horaria de las fuentes. No es cosmética: la capa de la EMT alterna
# entre UTC y hora local naive de un sondeo al siguiente (trampa 002).
TZ_LOCAL=Europe/Madrid

# Feed por defecto de los medidores de analysis/. La etiqueta de retraso no sale
# de aquí, sino de todas las versiones bajo GTFS_DIR (ADR-014).
GTFS_ZIP=data/raw/gtfs/emt_google_transit.zip

# Directorio con TODAS las versiones del GTFS (una por zip). El etiquetado usa,
# para cada día de servicio, la versión vigente más reciente.
GTFS_DIR=data/raw/gtfs

# Clave de Transitland para consultar las versiones archivadas del GTFS. La
# gratuita lee metadatos (qué publicó el editor y cuándo); el zip exige plan de pago.
TRANSITLAND_API_KEY=
