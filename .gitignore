# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Secrets
.env

# Datos — los gestionan DVC y el colector, nunca git.
# OJO: antes sólo se ignoraban raw/, interim/ y processed/, así que curated/,
# reference/, logs/ y _status.json se colaban en `git add -A`. Son cientos de
# megas de Parquet: GitHub rechaza ficheros de más de 100 MB y el historial
# quedaría inflado para siempre. Se ignora data/ entero.
data/
# Los .gitkeep ya están en el índice y siguen versionados aunque data/ esté aquí.

# Modelos (gestionados por DVC)
models/*.pkl
models/*.joblib

# MLflow
mlruns/
mlartifacts/
mlflow.db

# DVC
/.dvc/cache
/.dvc/tmp

# Ajustes locales de Claude Code (por máquina, no se comparten)
.claude/settings.local.json
